# Sensei pipeline — environment template
# Copy to .env and fill in your values. .env is git-ignored.

# --- data locations (relative to repo root) ---
# Point at the folder that contains per-camera subdirectories:
#   <images_dir>/<camera_id>/<timestamp>.jpg
SENSEI_IMAGES_DIR=data/Frutas e Legumes (train & test)

# --- inference backend ---
# "ollama" (local, default) or "gemini" (API booster)
SENSEI_BACKEND=ollama

# --- Ollama (local) ---
SENSEI_OLLAMA_URL=http://localhost:11434
SENSEI_OLLAMA_MODEL=qwen3-vl:8b
#SENSEI_OLLAMA_CTX=4096

# --- Gemini (API, optional booster) ---
#GEMINI_API_KEY=your-key-here
#SENSEI_MODEL=gemini-2.5-flash

# --- sampling ---
#SENSEI_SAMPLES=3
#SENSEI_TEMPERATURE=0.6

# --- geometry ---
#SENSEI_CROP_W=640
#SENSEI_CROP_H=448
#SENSEI_CONTEXT_PAD=0.35
#SENSEI_INCLUDE_CONTEXT=true

# --- runtime ---
#SENSEI_CONCURRENCY=6
#SENSEI_TIMEOUT_S=90
#SENSEI_RETRIES=4
#SENSEI_CACHE_DIR=.cache/vlm

# --- output ---
#SENSEI_OUTPUT=outputs/predictions.json

# --- colour net (speed shortcut) ---
#SENSEI_DARK_THR=0.60
#SENSEI_FRUIT_MAX=0.06
#SENSEI_TEXTURE_MAX=0.04

# --- MongoDB (optional, scripts/mongo_sync.py) ---
#MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
