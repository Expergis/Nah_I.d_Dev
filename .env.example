# Primary VLM — Google Gemini (recommended: fast + accurate + affordable)
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback VLM — OpenAI GPT-4o
OPENAI_API_KEY=your-openai-api-key-here

# Model Selection
VLM_PROVIDER=gemini          # 'gemini' or 'openai'
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o

# Pipeline Paths
DATA_DIR=./data
OUTPUT_DIR=./output
CACHE_DIR=./cache
PLANOGRAM_PATH=./planogram.json
